{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-temporary-drop-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "temporary-drop-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_UUID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "temporary-drop-staging" }],
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_ORIGIN": "https://personal-temporary-drop-staging.REPLACE.workers.dev",
    "R2_BUCKET_NAME": "temporary-drop-staging",
    "R2_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    "TOTP_SECRET_VERSION": "1",
    "PIN_VERSION": "1",
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
